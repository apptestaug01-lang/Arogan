# Production Environment Variables for LoanFlow Backend
# Set these in Render Dashboard → loanflow-backend → Environment → Secrets

# Database (provided by Render PostgreSQL)
DATABASE_URL=postgresql://arogandb_user:j9rooEMRQug0rCID5dc8Ae6VgbiNdyvp@dpg-da62hl0jo6nc73e5knag-a.oregon-postgres.render.com/arogandb

# JWT Secrets - Generate secure random strings (32+ chars)
# Use: openssl rand -base64 32
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Token Expiry
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Security
BCRYPT_COST=12
MAX_FAILED_ATTEMPTS=5
LOCKOUT_MINUTES=15

# OTP Settings
OTP_EXPIRY_SECONDS=60
OTP_MAX_REQUESTS_PER_WINDOW=5
OTP_WINDOW_MINUTES=10

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=5

# CORS & Frontend
CORS_ORIGIN=https://loanflow-frontend.onrender.com
FRONTEND_URL=https://loanflow-frontend.onrender.com

# Brevo SMTP (set in Render Dashboard Secrets)
BREVO_SMTP_USER=
BREVO_SMTP_PASS=
BREVO_FROM_EMAIL=no-reply@loanflow.app
BREVO_FROM_NAME=LoanFlow
BREVO_REPLY_TO=support@loanflow.app

# Server
PORT=
NODE_ENV=production
SESSION_CLEANUP_INTERVAL_MS=3600000
