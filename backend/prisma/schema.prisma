generator client {
  provider = "prisma-client-js"
  version  = "5.22.0"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  BORROWER
  ADMIN
  ANALYST
  APPROVER
}

enum OtpChannel {
  EMAIL
  SMS
}

model User {
  id             String    @id @default(cuid())
  fullName       String
  email          String    @unique
  mobile         String?
  countryCode    String    @default("+91")
  passwordHash   String?
  role           Role      @default(BORROWER)
  emailVerified  Boolean   @default(false)
  isActive       Boolean   @default(true)
  lockedUntil    DateTime?
  failedAttempts Int       @default(0)
  lastLoginAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  passwordResetToken       String?    @unique
  passwordResetExpiresAt   DateTime?

  sessions       Session[]
  auditLogs      AuditLog[]
  documents      Document[]
  applications   Application[]
}

model Session {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  refreshToken String   @unique
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  revoked      Boolean  @default(false)
}

model OTPRequest {
  id          String    @id @default(cuid())
  identifier  String
  codeHash    String
  channel     OtpChannel
  expiresAt   DateTime
  used        Boolean   @default(false)
  attemptCount Int      @default(0)
  createdAt   DateTime  @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  details   Json?
  ipAddress String?
  userAgent String?
  timestamp DateTime @default(now())
}

enum DocumentStatus {
  PENDING
  UPLOADED
  VERIFIED
  DELETED
}

model Document {
  id            String         @id
  userId        String
  user          User           @relation(fields: [userId], references: [id])
  applicationId String
  category      String?
  s3Key         String         @unique
  originalName  String
  contentType   String
  size          Int
  checksum      String
  status        DocumentStatus @default(PENDING)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  extraction    DocumentExtraction?
  documentArchive DocumentArchive?

  @@index([userId])
  @@index([applicationId])
}

model DocumentExtraction {
  id           String   @id @default(cuid())
  documentId   String   @unique
  document     Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  documentType String
  rawText      String   @db.Text
  pages        Json
  fields       Json
  status       String
  error        String?
  modelUsed    String?
  extractedAt  DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([documentId])
  @@index([status])
}

model DocumentArchive {
  id               String    @id @default(cuid())
  documentId       String    @unique
  document         Document  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  status           String    @default("PENDING") // PENDING|PROCESSING|COMPLETED|FAILED
  schemaVersion    String?
  converterVersion String?
  archiveKey       String?   // .loanflow/{docId}/document.json
  sourceSha256     String?
  sourceEtag       String?
  sourceSize       Int?
  byteTier         String?   // embedded | gz-object | source-object
  fidelityVerified Boolean   @default(false)
  warnings         Json?
  assets           Json?     // [{name,key,sha256,size}]
  error            Json?
  startedAt        DateTime?
  completedAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([status])
  @@index([documentId])
}

enum ApplicationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
}

model Application {
  id            String           @id @default(cuid())
  userId        String
  user          User             @relation(fields: [userId], references: [id])
  applicationId String           @unique
  status        ApplicationStatus @default(DRAFT)
  data          Json
  version       Int              @default(0)
  submittedAt   DateTime?
  reviewedAt    DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([userId])
  @@index([applicationId])
}
